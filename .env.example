# Copy this file to .env and fill in your own Stripe test-mode values.
# Never commit the real .env — it's gitignored.

# Secret key from Stripe Dashboard -> Developers -> API keys (test mode)
STRIPE_SECRET_KEY=sk_test_xxx

# Signing secret printed by `stripe listen` (starts with whsec_)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Price ID of a recurring product you created in the Stripe Dashboard
STRIPE_PRICE_ID=price_xxx

# Where the app runs locally
CLIENT_URL=http://localhost:4242
PORT=4242
